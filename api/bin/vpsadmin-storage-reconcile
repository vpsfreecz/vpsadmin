#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require_relative '../lib/vpsadmin'
require_relative '../lib/vpsadmin/storage_reconciler'

command = ARGV.shift
options = {}
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: vpsadmin-storage-reconcile capture|compare|dry-run|plan|activity-report [options]'
  opts.on('--pool-id ID', Integer) { |value| options[:pool_id] = value }
  opts.on('--run-id ID', Integer) { |value| options[:run_id] = value }
  opts.on('--mode MODE') { |value| options[:mode] = value }
  opts.on('--private-dir ABS') { |value| options[:private_dir] = value }
end

begin
  parser.parse!(ARGV)
  raise OptionParser::InvalidOption, 'unexpected argument' unless ARGV.empty?
  raise OptionParser::MissingArgument, '--private-dir' unless options[:private_dir]
  raise OptionParser::InvalidArgument, 'private directory must be absolute' unless
    File.absolute_path(options[:private_dir]) == options[:private_dir]

  case command
  when 'capture'
    raise OptionParser::MissingArgument, '--pool-id and --mode' unless
      options[:pool_id] && options[:mode]
    raise OptionParser::InvalidOption, '--run-id is not valid for capture' if options[:run_id]
    raise OptionParser::InvalidArgument, '--mode must be bootstrap or steady' unless
      %w[bootstrap steady].include?(options[:mode])

    runner = VpsAdmin::StorageReconciler::Capture.new(
      pool_id: options.fetch(:pool_id), mode: options.fetch(:mode),
      private_dir: options.fetch(:private_dir)
    )
    code = runner.run!
    puts "run_id=#{runner.run.id} state=#{code == 0 ? 'complete' : 'stale'}"
    exit(code)
  when 'compare', 'dry-run', 'plan'
    raise OptionParser::MissingArgument, '--run-id' unless options[:run_id]
    raise OptionParser::InvalidOption, '--pool-id and --mode are capture-only' if
      options[:pool_id] || options[:mode]

    begin
      store = VpsAdmin::StorageReconciler::PrivateStore.new(
        root: options.fetch(:private_dir), run_id: options.fetch(:run_id)
      )
      artifacts = VpsAdmin::StorageReconciler::Artifacts.new(store)
      result = case command
               when 'compare' then artifacts.compare!
               when 'dry-run' then artifacts.dry_run!
               else artifacts.plan!
               end
      count = case command
              when 'compare' then result.fetch('findings')
              when 'dry-run' then result.fetch('candidate_count')
              else result.fetch('action_count')
              end
      puts "run_id=#{options.fetch(:run_id)} #{command}=complete count=#{count}"
    rescue VpsAdmin::StorageReconciler::PrivateStore::Invalid,
           VpsAdmin::StorageReconciler::Artifacts::Invalid,
           VpsAdmin::StorageReconciler::Comparator::Invalid,
           VpsAdmin::StorageReconciler::ProofPlanner::Invalid,
           VpsAdmin::StorageReconciler::Format::Invalid,
           Errno::ENOENT, Errno::ELOOP, JSON::ParserError, KeyError => e
      warn "invalid storage reconciliation artifacts: #{e.class.name.split('::').last}"
      exit(3)
    end
  when 'activity-report'
    raise OptionParser::InvalidOption, '--pool-id, --run-id and --mode are not valid' if
      options[:pool_id] || options[:run_id] || options[:mode]

    runner = VpsAdmin::StorageReconciler::ActivityReport.new(
      private_dir: options.fetch(:private_dir)
    )
    result = runner.run!
    puts "activity_report=#{File.basename(runner.report_directory)} state=#{result.fetch('state')}"
    # Child lifetime coverage is incomplete, so this report never exits as ready.
    exit(2)
  else
    raise OptionParser::InvalidArgument, 'choose capture, compare, dry-run, plan or activity-report'
  end
rescue OptionParser::ParseError => e
  warn "invalid arguments: #{e.message}"
  warn parser
  exit(3)
rescue StandardError => e
  warn "storage reconciliation incomplete: #{e.class.name.split('::').last}"
  exit(2)
end
