<% if @incident_policy_summary -%>
<% summary = @incident_policy_summary; value = ->(v) { v.nil? ? 'unknown' : v }; yes_no = ->(v) { v.nil? ? 'unknown' : v ? 'yes' : 'no' }; date = ->(v) { v ? local_time(v, '%Y-%m-%d %H:%M:%S %Z') : 'unknown' }; mail_state = ->(v) { v == 'sent' ? 'Accepted by mail server' : value.call(v) } -%>

Incident policies
Current matches at <%= date.call(summary[:as_of]) %>.
Recorded activity period: <%= date.call(summary[:period_start]) %> to <%= date.call(summary[:period_end]) %> (up to, but not including, the end time).
