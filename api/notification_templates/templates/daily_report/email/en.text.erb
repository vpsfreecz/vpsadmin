  Activity: <%= date.call(row[:activity_at]) %> (<%= { 'evaluation' => 'evaluation', 'stop_completed' => 'confirmed shutdown', 'mail_queued' => 'mail queued', 'mail_finished' => 'mail attempt finished', 'action_updated' => 'failed or uncertain outcome last updated' }.fetch(row[:activity_basis], row[:activity_basis]) %>).
<% end -%>
