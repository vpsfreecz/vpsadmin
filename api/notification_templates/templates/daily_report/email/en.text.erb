<% if collection[:rows].empty? -%>
<%= name == :activity ? 'No recorded policy activity during this period.' : 'No outstanding policy actions.' %>
<% else -%>

<%= title %>: showing <%= collection[:rows].length %> of <%= collection[:total_count] %>; omitted <%= collection[:omitted_count] %>.
