  Last warning queued: <%= date.call(row[:last_warning_at]) %>; warning cooldown ends: <%= date.call(row[:next_warning_allowed_at]) %>.
  Last confirmed shutdown: <%= date.call(row[:last_stop_at]) %>; shutdown cooldown ends: <%= date.call(row[:next_stop_allowed_at]) %>.
  Outstanding shared shutdown: <%= row[:outstanding_stop_state] %> (action <%= value.call(row[:outstanding_stop_action_id]) %>, chain <%= value.call(row[:outstanding_stop_chain_id]) %>).
<% if row[:latest_action_id] -%>
  Latest action: <%= value.call(row[:latest_action_kind]) %> / <%= value.call(row[:latest_action_state]) %>; mail: <%= mail_state.call(row[:latest_mail_state]) %>.
<% if row[:latest_stop_completed_at] -%>
  Confirmed shutdown: <%= date.call(row[:latest_stop_completed_at]) %>.
<% end -%>
<% else -%>
  No recorded action.
<% end -%>
<% %i[vps_url report_url policy_url transaction_url].each do |key| -%>
