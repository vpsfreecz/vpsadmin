  Current action: #<%= value.call(row[:action_id]) %> <%= value.call(row[:action_kind]) %> / <%= value.call(row[:action_state]) %>; created <%= date.call(row[:action_created_at]) %>, updated <%= date.call(row[:action_updated_at]) %>.
  Shared shutdown action ID: <%= value.call(row[:physical_stop_action_id]) %>; confirmed completion: <%= date.call(row[:stop_completed_at]) %>; chain: <%= value.call(row[:transaction_chain_id]) %>.
