<!DOCTYPE html>
<html lang="<%= Rack::Utils.escape_html(html_lang) %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= html_t.call(:title) %></title>
    <style>
      :root { color-scheme: light; font-family: system-ui, sans-serif; }
      body { background: #f4f5f7; color: #20252b; margin: 0; padding: 2rem 1rem; }
      main { background: white; border: 1px solid #d9dde2; border-radius: .5rem;
             box-shadow: 0 .25rem 1rem rgba(0, 0, 0, .08); margin: 0 auto;
             max-width: 30rem; padding: 1.75rem; }
      .logo { display: block; height: auto; margin: 0 auto 1.5rem;
              max-width: 100%; }
      h1 { font-size: 1.5rem; margin: 0 0 1rem; text-align: center; }
      p { line-height: 1.5; }
      label { display: block; font-weight: 600; margin: 1rem 0 .35rem; }
      input[type="text"], input[type="password"], input[type="email"] {
        border: 1px solid #aeb5bd; border-radius: .25rem; box-sizing: border-box;
        font: inherit; padding: .65rem .75rem; width: 100%;
      }
      button { background: #0875c1; border: 0; border-radius: .25rem;
               box-sizing: border-box; color: white; cursor: pointer;
               display: inline-block; font: inherit; margin-top: 1rem;
               padding: .7rem 1rem; text-align: center; width: 100%; }
      button.secondary { background: #59636e; }
      .notice { background: #e9f4fb; border-left: .25rem solid #0875c1;
                margin: 1rem 0; padding: .75rem 1rem; }
      .error { background: #fbeaec; border-left: .25rem solid #b4232d;
               margin: 1rem 0; padding: .75rem 1rem; }
      .muted { color: #59636e; font-size: .9rem; }
      .back-to-sign-in { text-align: center; }
      .check { align-items: flex-start; display: flex; gap: .5rem; margin-top: 1rem; }
      .check label { font-weight: normal; margin: 0; }
      .account { font-family: ui-monospace, monospace; }
      a { color: #075f9d; }
    </style>
    <% if state == :landing -%>
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const token = new URLSearchParams(window.location.hash.slice(1)).get('token');
          history.replaceState(null, '', window.location.pathname + window.location.search);
          if (token) {
            document.getElementById('email-token').value = token;
            document.getElementById('continue-form').submit();
          } else {
            document.getElementById('landing-error').hidden = false;
          }
        });
      </script>
    <% elsif state == :mfa && mfa_methods.include?(:webauthn) -%>
      <script>
        function bufferDecode(value) {
          return Uint8Array.from(atob(value.replace(/_/g, '/').replace(/-/g, '+')), c => c.charCodeAt(0));
        }

        function bufferEncode(value) {
          return btoa(String.fromCharCode.apply(null, new Uint8Array(value)))
            .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
        }

        async function authenticatePasskey() {
          const button = document.getElementById('passkey-button');
          const alert = document.getElementById('passkey-error');
          button.disabled = true;
          button.textContent = <%= js_t.call(:signing_in_passkey) %>;
          alert.hidden = true;

          try {
            if (!navigator.credentials) throw new Error(<%= js_t.call(:passkey_start_failed) %>);
            const csrf = document.querySelector('input[name="csrf_token"]').value;
            const start = await fetch('<%= BASE_PATH %>/verify/webauthn/begin', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
              body: '{}'
            });
            const startData = await start.json();
            if (!start.ok || !startData.status) throw new Error(startData.message);

            const options = startData.options;
            options.challenge = bufferDecode(options.challenge);
            (options.allowCredentials || []).forEach(item => { item.id = bufferDecode(item.id); });
            const assertion = await navigator.credentials.get({ publicKey: options });
            const finish = await fetch('<%= BASE_PATH %>/verify/webauthn/finish', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
              body: JSON.stringify({
                challenge_token: startData.challenge_token,
                public_key_credential: {
                  id: assertion.id,
                  rawId: bufferEncode(assertion.rawId),
                  type: assertion.type,
                  response: {
                    authenticatorData: bufferEncode(assertion.response.authenticatorData),
                    clientDataJSON: bufferEncode(assertion.response.clientDataJSON),
                    signature: bufferEncode(assertion.response.signature),
                    userHandle: assertion.response.userHandle
                      ? bufferEncode(assertion.response.userHandle) : null
                  }
                }
              })
            });
            const finishData = await finish.json();
            if (!finish.ok || !finishData.status) throw new Error(finishData.message);
            window.location.assign('<%= BASE_PATH %>/password');
          } catch (e) {
            alert.textContent = e.message || <%= js_t.call(:passkey_failed) %>;
            alert.hidden = false;
            button.disabled = false;
            button.textContent = <%= js_t.call(:passkey) %>;
          }
        }
      </script>
    <% end -%>
  </head>
  <body>
    <main>
      <% if logo_url -%>
        <img class="logo" src="<%= Rack::Utils.escape_html(logo_url) %>" alt="vpsFree.cz">
      <% end -%>
      <% if state == :request -%>
        <h1><%= html_t.call(:request_heading) %></h1>
        <p><%= html_t.call(:request_explanation) %></p>
        <% if error -%><div class="error"><%= Rack::Utils.escape_html(error) %></div><% end -%>
        <form action="<%= BASE_PATH %>" method="post">
          <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
          <% if oauth2_client -%>
            <input type="hidden" name="client_id" value="<%= Rack::Utils.escape_html(oauth2_client.client_id) %>">
          <% end -%>
          <% if @params['ui_locales'].present? -%>
            <input type="hidden" name="ui_locales" value="<%= Rack::Utils.escape_html(@params['ui_locales']) %>">
          <% end -%>
          <label for="identifier"><%= html_t.call(:identifier) %></label>
          <input id="identifier" name="identifier" type="text" autocomplete="username"
                 maxlength="127" value="<%= Rack::Utils.escape_html(@params['identifier'].to_s) %>"
                 required autofocus>
          <button type="submit"><%= html_t.call(:send_email) %></button>
        </form>
        <% if back_to_sign_in_uri.present? -%>
          <p class="muted back-to-sign-in"><a href="<%= Rack::Utils.escape_html(back_to_sign_in_uri) %>"><%= html_t.call(:back_to_sign_in) %></a></p>
        <% end -%>

      <% elsif state == :sent -%>
        <h1><%= html_t.call(:email_sent) %></h1>
        <div class="notice"><%= html_t.call(:email_sent_explanation) %></div>
        <% if back_to_sign_in_uri.present? -%>
          <p class="muted back-to-sign-in"><a href="<%= Rack::Utils.escape_html(back_to_sign_in_uri) %>"><%= html_t.call(:back_to_sign_in) %></a></p>
        <% end -%>

      <% elsif state == :landing -%>
        <h1><%= html_t.call(:title) %></h1>
        <p><%= html_t.call(:continue) %></p>
        <div id="landing-error" class="error" hidden><%= html_t.call(:invalid_link) %></div>
        <form id="continue-form" action="<%= BASE_PATH %>/continue" method="post">
          <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
          <input id="email-token" type="hidden" name="token">
          <noscript><p class="error"><%= html_t.call(:recovery_unavailable) %></p></noscript>
        </form>

      <% elsif state == :mfa -%>
        <h1><%= html_t.call(:mfa_heading) %></h1>
        <p><%= html_t.call(:mfa_explanation) %></p>
        <% if error -%><div class="error"><%= Rack::Utils.escape_html(error) %></div><% end -%>
        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <% if mfa_methods.include?(:totp) -%>
          <form action="<%= BASE_PATH %>/verify/totp" method="post">
            <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
            <label for="totp-code"><%= html_t.call(:totp_code) %></label>
            <input id="totp-code" name="totp_code" type="text" inputmode="numeric"
                   autocomplete="one-time-code" required autofocus>
            <button type="submit"><%= html_t.call(:verify_totp) %></button>
          </form>
        <% end -%>
        <% if mfa_methods.include?(:webauthn) -%>
          <div id="passkey-error" class="error" hidden></div>
          <button id="passkey-button" class="secondary" type="button"
                  onclick="authenticatePasskey()"><%= html_t.call(:passkey) %></button>
        <% end -%>

      <% elsif state == :password -%>
        <h1><%= html_t.call(:password_heading) %></h1>
        <p class="account"><%= Rack::Utils.escape_html(recovery.user.login) %></p>
        <% if error -%><div class="error"><%= Rack::Utils.escape_html(error) %></div><% end -%>
        <form action="<%= BASE_PATH %>/password" method="post">
          <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
          <label for="new-password"><%= html_t.call(:new_password) %></label>
          <input id="new-password" name="new_password" type="password"
                 minlength="8" autocomplete="new-password" required autofocus>
          <label for="repeat-new-password"><%= html_t.call(:repeat_new_password) %></label>
          <input id="repeat-new-password" name="repeat_new_password" type="password"
                 minlength="8" autocomplete="new-password" required>
          <div class="check">
            <input id="sign-out-all" name="sign_out_all" type="checkbox" value="1" checked>
            <label for="sign-out-all"><%= html_t.call(:sign_out_all) %></label>
          </div>
          <button type="submit"><%= html_t.call(:change_password) %></button>
        </form>

      <% elsif state == :complete -%>
        <h1><%= html_t.call(:complete) %></h1>

      <% else -%>
        <h1><%= html_t.call(:title) %></h1>
        <div class="error"><%= error ? Rack::Utils.escape_html(error) : html_t.call(:invalid_link) %></div>
      <% end -%>
    </main>
  </body>
</html>
